FROM node:20-slim AS base

RUN npm --global install pnpm

FROM base AS pruner
# Cache-bust marker: Railway/BuildKit caches every layer when the prior image
# digest matches, even across our app's source changes. Bumping this string
# (or any earlier line in the Dockerfile) invalidates all subsequent layers
# and forces a real rebuild instead of a no-op cached push.
ARG BUILD_CACHE_BUST=2026-05-14-001
RUN npm --global install turbo
WORKDIR /app
COPY . .
RUN turbo prune --scope=backend --docker

FROM base AS builder
WORKDIR /app
COPY .gitignore .gitignore
COPY .npmrc ./
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml

RUN pnpm install

COPY --from=pruner /app/out/full/ .
COPY turbo.json turbo.json

RUN NODE_OPTIONS="--max_old_space_size=4096" pnpm turbo run build --filter=backend... --force

FROM base AS runner
WORKDIR /app

# Create the runtime user with a real home directory at /home/nodeuser so
# any tool that touches $HOME (pnpm, npm, AWS SDK config) has somewhere to write.
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 --home /home/nodeuser --shell /bin/sh nodeuser

COPY --from=builder /app .
RUN chown -R nodeuser:nodejs /app /home/nodeuser

USER nodeuser
ENV HOME=/home/nodeuser
ENV NODE_ENV=production

EXPOSE 8001
# Run the compiled entry directly — no pnpm/turbo at runtime, so we don't
# need a writable .local/share/pnpm cache for tooling.
CMD ["node", "apps/backend/dist/bootstrap.js"]
