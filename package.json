{
  "name": "corpus-ai",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "concurrently \"turbo dev --concurrency 15\" \"cross-env NODE_ENV=development node proxy-server.js\"",
    "dev:no-proxy": "turbo dev --concurrency 15",
    "dev:frontend": "concurrently \"turbo dev --filter=website --filter=docs --filter=dashboard --filter=backend --filter=@corpusai/ui --concurrency 10\" \"cross-env NODE_ENV=development node proxy-server.js\"",
    "proxy:dev": "cross-env NODE_ENV=development node proxy-server.js",
    "proxy:prod": "NODE_ENV=production node proxy-server.js",
    "build": "turbo build",
    "clean": "git clean -xdf node_modules",
    "clean:ws": "turbo clean",
    "start": "concurrently \"cross-env USE_PROXY=true turbo start\" \"cross-env NODE_ENV=production node proxy-server.js\"",
    "format": "turbo format --continue -- --cache --cache-location node_modules/.cache/.prettiercache",
    "format:fix": "turbo format --continue -- --write --cache --cache-location node_modules/.cache/.prettiercache",
    "lint": "turbo lint",
    "lint:fix": "turbo lint --continue -- --fix",
    "docker:up": "docker compose up -d",
    "docker:rebuild": "docker compose down && docker compose build --no-cache && docker compose up -d",
    "docker:logs": "docker compose logs -f",
    "docker:staging": "docker compose -f docker-compose.yaml -f docker-compose.staging.yml up -d",
    "docker:staging:build": "docker compose -f docker-compose.yaml -f docker-compose.staging.yml build --no-cache",
    "docker:production": "docker compose -f docker-compose.yaml -f docker-compose.production.yml up -d",
    "docker:production:build": "docker compose -f docker-compose.yaml -f docker-compose.production.yml build --no-cache",
    "secrets:push:staging": "node scripts/push-secrets.js --env apps/backend/.env.development --secret corpus-ai/staging",
    "secrets:push:production": "node scripts/push-secrets.js --env apps/backend/.env.production --secret corpus-ai/production",
    "db:setup:staging": "node apps/backend/setup-aws-dynamodb.js",
    "db:setup:local": "node apps/backend/setup-aws-dynamodb.js --local"
  },
"devDependencies": {
  "@types/node": "20.17.0",
  "eslint": "^8.40.0",
  "eslint-config-prettier": "^8.8.0",
  "prettier": "^3.0.2",
  "turbo": "^2.5.3",
  "typescript": "^5.1.6",
  "concurrently": "^8.2.2",
  "cross-env": "^7.0.3"
},
  "dependencies": {
    "express": "^4.18.2",
    "http-proxy-middleware": "^2.0.6",
    "cors": "^2.8.5"
  },
  "engines": {
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm",
    "pnpm": ">=9.0.0",
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@9.1.4",
  "pnpm": {
    "overrides": {
      "@types/node": "20.17.0"
    }
  }
}
