{
  "services": [
    {
      "name": "website",
      "root": ".",
      "build": {
        "dockerfilePath": "docker/Dockerfile.website",
        "context": "."
      }
    },
    {
      "name": "dashboard",
      "root": ".",
      "build": {
        "dockerfilePath": "docker/Dockerfile.dashboard",
        "context": "."
      }
    },
    {
      "name": "docs",
      "root": ".",
      "build": {
        "dockerfilePath": "docker/Dockerfile.docs",
        "context": "."
      }
    },
    {
      "name": "backend",
      "root": ".",
      "build": {
        "dockerfilePath": "docker/Dockerfile.backend",
        "context": "."
      }
    },
    {
      "name": "chat_service",
      "root": ".",
      "build": {
        "dockerfilePath": "docker/Dockerfile.chat_service",
        "context": "."
      }
    },
    {
      "name": "proxy",
      "root": ".",
      "build": {
        "dockerfilePath": "docker/Dockerfile.proxy",
        "context": "."
      },
      "deploy": {
        "startCommand": "nginx -g 'daemon off;'",
        "healthcheckPath": "/"
      }
    }
  ]
}