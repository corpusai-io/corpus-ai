{
  "services": [
    {
      "name": "website",
      "root": ".",
      "build": {
        "dockerfilePath": "docker/docker.website",
        "context": "."
      }
    },
    {
      "name": "dashboard",
      "root": ".",
      "build": {
        "dockerfilePath": "docker/docker.dashboard",
        "context": "."
      }
    },
    {
      "name": "docs",
      "root": ".",
      "build": {
        "dockerfilePath": "docker/docker.docs",
        "context": "."
      }
    },
    {
      "name": "proxy",
      "root": ".",
      "build": {
        "dockerfilePath": "docker/docker.proxy",
        "context": "."
      },
      "deploy": {
        "startCommand": "nginx -g 'daemon off;'",
        "healthcheckPath": "/"
      }
    }
  ]
}
