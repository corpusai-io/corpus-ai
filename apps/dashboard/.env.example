# ─── Dashboard — Environment Template ───────────────────────────────────────
# Copy this file to .env.local and fill in values for local development.
# NEVER put real credentials in this file — it is committed to git.
#
# Vercel staging vars:
#   NEXT_PUBLIC_API_URL=https://api-staging.corpusai.io
#   NEXT_PUBLIC_APP_URL=https://app-staging.corpusai.io
#   NEXT_PUBLIC_WEBSITE_URL=https://staging.corpusai.io
#
# Vercel production vars:
#   NEXT_PUBLIC_API_URL=https://api.corpusai.io
#   NEXT_PUBLIC_APP_URL=https://app.corpusai.io
#   NEXT_PUBLIC_WEBSITE_URL=https://corpusai.io
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8001

# Dashboard's own URL (used for absolute links and auth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:8080

# Website URL (used for logout redirect)
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000

# Suppress Node.js experimental API warnings in development
NODE_OPTIONS=--no-warnings
