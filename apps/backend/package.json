{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "cross-env DOTENV_CONFIG_PATH=.env.local tsx watch -r dotenv/config src/bootstrap.ts",
    "build": "tsc",
    "start": "node dist/bootstrap.js",
    "start:dev-local": "cross-env PORT=8001 node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "test": "jest --testMatch='**/__tests__/debug.test.ts' --verbose --detectOpenHandles",
    "test:phase3": "jest --testMatch='**/__tests__/phase3.test.ts' --verbose --detectOpenHandles",
    "test:all": "jest --verbose --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "setup:aws": "node setup-aws-dynamodb.js",
    "setup:staging": "node setup-aws-dynamodb.js --stage staging",
    "setup:production": "node setup-aws-dynamodb.js --stage production",
    "setup:local": "node setup-aws-dynamodb.js --local"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.450.0",
    "@aws-sdk/client-dynamodb": "^3.450.0",
    "@aws-sdk/client-s3": "^3.450.0",
    "@aws-sdk/client-ses": "^3.990.0",
    "@aws-sdk/lib-dynamodb": "^3.450.0",
    "@aws-sdk/s3-request-presigner": "^3.450.0",
    "@corpusai/aws-common": "workspace:*",
    "@mendable/firecrawl-js": "^1.0.0",
    "express-rate-limit": "^7.4.1",
    "ioredis": "^5.4.1",
    "rate-limit-redis": "^4.2.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "amazon-cognito-identity-js": "^6.3.16",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "dynamoose": "^4.0.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.12.0",
    "mssql": "^11.0.1",
    "multer": "^2.0.2",
    "mysql2": "^3.12.0",
    "nanoid": "^3.3.7",
    "openai": "^4.0.0",
    "pg": "^8.13.1",
    "stripe": "^20.3.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.0.0",
    "@types/mssql": "^9.1.5",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "cross-env": "^7.0.3",
    "jest": "^29.0.0",
    "ts-jest": "^29.4.6",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  }
}
