# ─── Backend — Environment Template ─────────────────────────────────────────
# Copy this file to .env.local and fill in real values for local development.
# NEVER put real credentials in this file — it is committed to git.
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8001

# ─── AWS Core ────────────────────────────────────────────────────────────────
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── AWS Secrets Manager ─────────────────────────────────────────────────────
# Leave blank for local dev. Set to corpus-ai/staging or corpus-ai/production
# to load all secrets from SM at startup (only AWS creds above are then needed).
AWS_SM_SECRET_NAME=

# ─── Local DynamoDB (Docker) ─────────────────────────────────────────────────
# Set to http://localhost:8000 for Docker DynamoDB (pnpm docker:up).
# Comment out or leave blank to use real AWS DynamoDB.
DYNAMODB_ENDPOINT=http://localhost:8000

# ─── DynamoDB Table Names ────────────────────────────────────────────────────
AWS_DYNAMO_USER_TABLE=corpus-users-dev
AWS_DYNAMO_CHATBOT_TABLE=corpus-chatbots-dev
AWS_DYNAMO_CUSTOMIZATION_TABLE=corpus-customization-dev
AWS_DYNAMO_ACCESS_CONTROL_TABLE=corpus-access-control-dev
AWS_DYNAMO_QUERY_LOG_TABLE=corpus-query-log-dev
AWS_DYNAMO_LEAD_GENERATION_TABLE=corpus-lead-generation-dev
AWS_DYNAMO_MAIN_TABLE=corpus-main-dev
AWS_DYNAMO_INTEGRATIONS_TABLE=corpus-integrations-dev
AWS_DYNAMO_API_KEYS_TABLE=corpus-api-keys-dev
AWS_DYNAMO_DATABASE_CONNECTIONS_TABLE=corpus-database-connections-dev
AWS_DYNAMO_CHAT_HISTORY_TABLE=corpus-chat-history-dev
AWS_DYNAMO_AI_ACTIONS_TABLE=corpus-ai-actions-dev
AWS_DYNAMO_BUILTIN_INTEGRATIONS_TABLE=corpus-builtin-integrations-dev
AWS_DYNAMO_RESPONSE_CACHE_TABLE=corpus-response-cache-dev

# ─── S3 ──────────────────────────────────────────────────────────────────────
S3_BUCKET_NAME=corpus-ai-files-dev
S3_REGION=eu-north-1

# ─── SQS ─────────────────────────────────────────────────────────────────────
SQS_BUILD_QUEUE_URL=https://sqs.eu-north-1.amazonaws.com/<ACCOUNT_ID>/corpus-ai-queue
SQS_REGION=eu-north-1

# ─── Cognito ─────────────────────────────────────────────────────────────────
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_CLIENT_ID=
AWS_COGNITO_REGION=eu-north-1
AWS_COGNITO_DOMAIN=

# ─── URLs ────────────────────────────────────────────────────────────────────
GOOGLE_SSO_CALLBACK_URL=http://localhost:8001/api/auth/google/callback
DASHBOARD_URL=http://localhost:8080
WEBSITE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ─── SES (email) ─────────────────────────────────────────────────────────────
SES_SENDER_EMAIL=noreply@corpusai.io
SES_REGION=eu-north-1

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# ─── Pinecone ────────────────────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_REGION=us-east-1
PINECONE_INDEX=corpus-dense
PINECONE_SPARSE_INDEX=corpus-sparse

# ─── Cohere ──────────────────────────────────────────────────────────────────
COHERE_API_KEY=

# ─── Firecrawl ───────────────────────────────────────────────────────────────
FIRECRAWL_API_KEY=

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_STANDARD=
STRIPE_PRICE_ID_BUSINESS=

# ─── Redis (rate limiting across replicas) ───────────────────────────────────
# Required for production / multi-replica deploys. Leave blank for local dev
# (rate limiter falls back to in-memory store, single-process only).
# Upstash example: rediss://default:<TOKEN>@<region>.upstash.io:6379
REDIS_URL=

# ─── Security ────────────────────────────────────────────────────────────────
# Generate a unique key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATABASE_ENCRYPTION_KEY=

# ─── Quotas ──────────────────────────────────────────────────────────────────
CHAT_QUOTA=[20, 1500, 7500, 15000]
CRAWL_QUOTA=[100, 100, 2000, 10000]
STORAGE_QUOTA=[52428800, 52428800, 1073741824, 53687091200]
BOT_QUOTA=[1, 2, 4, 8]
FREE_TRIAL_EXPIRATION_DAYS=10

# ─── Slack Integration ───────────────────────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=

# ─── WhatsApp ────────────────────────────────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=corpus-ai-verify-token
WHATSAPP_ACCESS_TOKEN=

# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ─── Dev / Testing ───────────────────────────────────────────────────────────
API_URL=http://localhost:8001
SUPPRESS_TEST_LOGS=false
