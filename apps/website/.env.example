# ─── Website — Environment Template ─────────────────────────────────────────
# Copy this file to .env.local and fill in values for local development.
# NEVER put real credentials in this file — it is committed to git.
#
# Vercel staging vars:
#   NEXT_PUBLIC_API_URL=https://api-staging.corpusai.io
#   NEXT_PUBLIC_APP_URL=https://staging.corpusai.io
#   NEXT_PUBLIC_DASHBOARD_URL=https://app-staging.corpusai.io/dashboard
#
# Vercel production vars:
#   NEXT_PUBLIC_API_URL=https://api.corpusai.io
#   NEXT_PUBLIC_APP_URL=https://corpusai.io
#   NEXT_PUBLIC_DASHBOARD_URL=https://app.corpusai.io/dashboard
# ─────────────────────────────────────────────────────────────────────────────

# Website's own base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API base URL (for server-side API calls from website)
NEXT_PUBLIC_API_URL=http://localhost:8001

# Dashboard URL (for post-login redirect and CTA buttons)
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:8080/dashboard
