# ─── lambdaChat — Environment Template ──────────────────────────────────────
# Copy this file to .env.local and fill in values for local development.
# NEVER put real credentials in this file — it is committed to git.
#
# Deployed via Serverless Framework (pnpm deploy:dev / pnpm deploy:prod).
# For deployed lambdas, env vars come from serverless.yml environment section
# or AWS Parameter Store — not from .env files.
# ─────────────────────────────────────────────────────────────────────────────

# ─── AWS Core ────────────────────────────────────────────────────────────────
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── DynamoDB ────────────────────────────────────────────────────────────────
AWS_DYNAMO_CHATBOT_TABLE=corpus-chatbots-dev
AWS_DYNAMO_USER_TABLE=corpus-users-dev
AWS_DYNAMO_QUERY_LOG_TABLE=corpus-query-log-dev
AWS_DYNAMO_INTEGRATIONS_TABLE=corpus-integrations-dev
AWS_DYNAMO_CUSTOMIZATION_TABLE=corpus-customization-dev
AWS_DYNAMO_RESPONSE_CACHE_TABLE=corpus-response-cache-dev

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# ─── Pinecone ────────────────────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1
PINECONE_REGION=us-east-1
PINECONE_INDEX=corpus-dense
PINECONE_SPARSE_INDEX=corpus-sparse

# ─── Cohere ──────────────────────────────────────────────────────────────────
COHERE_API_KEY=

# ─── Cognito ─────────────────────────────────────────────────────────────────
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_REGION=eu-north-1

# ─── Quotas ──────────────────────────────────────────────────────────────────
CHAT_QUOTA=[20, 1500, 7500, 15000]

# ─── Slack ───────────────────────────────────────────────────────────────────
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ─── WhatsApp ────────────────────────────────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=corpus-ai-verify-token
WHATSAPP_ACCESS_TOKEN=

# ─── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ─── Security ────────────────────────────────────────────────────────────────
DATABASE_ENCRYPTION_KEY=
